model Flyable {
    open attr<max_altitude>

    init(alt) {
        max_altitude: alt
    }

    open method fly() {
        show("Flying up to " + String(max_altitude) + " metres!")
    }
}

model Swimmable {
    open attr<max_depth>

    init(depth) {
        max_depth: depth
    }

    open method swim() {
        show("Diving down to " + String(max_depth) + " metres!")
    }
}

model Runnable {
    open attr<top_speed>

    init(speed) {
        top_speed: speed
    }

    open method run() {
        show("Sprinting at " + String(top_speed) + " km/h!")
    }
}

model Duck: Flyable, Swimmable, Runnable {
    open attr<name>

    init(name, alt, depth, speed) {
        name: name
        max_altitude: alt
        max_depth: depth
        top_speed: speed
    }

    open method introduce() {
        show("Hi, I am " + name + " the duck!")
    }

    open method show_all() {
        introduce()
        fly()
        swim()
        run()
    }
}

donald = Duck("Donald", 120, 5, 12)
donald.show_all()
show("Max altitude : " + String(donald.max_altitude))
show("Max depth    : " + String(donald.max_depth))
show("Top speed    : " + String(donald.top_speed))