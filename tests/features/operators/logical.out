--- Test: Logical Operators ---
true and true -> True
true and false -> False
false and true -> False
false and false -> False
true or true -> True
true or false -> True
false or true -> True
false or false -> False
not true -> False
not false -> True
--- Test: Operator Precedence ---
5 + 2 * 3 -> 11
(5 + 2) * 3 -> 21
not 0 and 1 -> True
not (0 and 1) -> True
