--- Test: Comparison Operators ---
10 == 10 -> True
10 == 5 -> False
"a" == "a" -> True
"a" == "b" -> False
10 != 5 -> True
10 != 10 -> False
"a" != "b" -> True
"a" != "a" -> False
10 > 5 -> True
5 > 10 -> False
5 < 10 -> True
10 < 5 -> False
10 >= 10 -> True
10 >= 5 -> True
5 >= 10 -> False
10 <= 10 -> True
5 <= 10 -> True
10 <= 5 -> False
