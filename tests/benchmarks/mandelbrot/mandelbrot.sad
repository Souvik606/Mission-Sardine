method mandelbrot(size, iterations) {
    count = 0
    cycle y = 0:(size - 1) {
        cycle x = 0:(size - 1) {
            cr = (x * 3.0 / size) - 1.5
            ci = (y * 3.0 / size) - 1.5
            zr = 0.0
            zi = 0.0
            i = 0
            during i < iterations and (zr * zr + zi * zi < 4.0) {
                temp = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = temp
                i = i + 1
            }
            when i == iterations {
                count = count + 1
            }
        }
    }
    yield count
}

show("mandelbrot count =", mandelbrot(30, 30))
